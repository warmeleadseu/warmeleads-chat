# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Sessie-JWT (admin + portal + impersonatie). Min. 32 tekens. Zet dit in Vercel
# productie (niet alleen CRON_SECRET gebruiken).
APP_SESSION_SECRET=

# Admin-auth debug: server (Vercel function logs) + client (ingelogde adminFetch).
# Optioneel: alleen serverlogs zonder client-buildflag.
NEXT_PUBLIC_ADMIN_AUTH_DEBUG=
ADMIN_AUTH_DEBUG=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database Configuration (legacy - niet meer nodig met Supabase)
DATABASE_URL=postgresql://username:password@localhost:5432/warmeleads
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Email Configuration (for future use)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@warmeleads.nl

# CRM Integration (for future use)
HUBSPOT_API_KEY=your_hubspot_api_key
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret

# Lead Generation API (for future use)
LEAD_GENERATION_API_URL=https://api.leadprovider.com
LEAD_GENERATION_API_KEY=your_lead_api_key

# Analytics (for future use)
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
FACEBOOK_PIXEL_ID=your_facebook_pixel_id

# Twilio WhatsApp Business API (QuickPulse Style)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel KV for WhatsApp config storage
KV_URL=your_vercel_kv_url
KV_REST_API_TOKEN=your_vercel_kv_token

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Resend API for email notifications
RESEND_API_KEY=re_your_resend_api_key

# Meta/Facebook Ads Configuration
# Campaign status sync (batch ↔ Meta): token needs ads_management + campagnes in dit ad account.
META_APP_ID=827176273582025
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_app_id|your_app_secret
META_AD_ACCOUNT_ID=act_xxxxxxxx
META_WEBHOOK_VERIFY_TOKEN=warmeleads_verify_token

# Meta Conversions API for Lead Ads (server-side Lead-events).
#
# WarmeLeads model:
#   • We runnen Meta Lead Ads (geen website-pixels).
#   • Onze KPI = veel leads per branche tegen lage CPL — we doen NIETS met
#     klant-side conversie (verkocht/offerte), dus we sturen alleen `Lead`-events
#     (geen QualifiedLead/Purchase). Dat geeft Meta's ML een schoner signaal.
#   • Eén dataset volstaat voor alle branches: per event geven we `branch` +
#     `meta_campaign_id/adset_id/ad_id` + Lead Ads submission `lead_id` mee zodat
#     Meta de events terugkoppelt aan de juiste campagne/adset/ad.
#   • CAPI fires alleen voor leads met phone_valid !== false. Zo voorkomen we
#     dat Meta's optimizer junk-leads als positief signaal pakt.
#
# Setup:
#   Events Manager → Datasets → Connect data source → Web → Conversions API
#   (een Pixel werkt ook; technisch is dat gewoon een dataset.)
#
# Access token: hergebruik META_ACCESS_TOKEN als die System User toegang heeft
# tot de dataset (gebruikelijk), of maak een dedicated token. Test event code
# alleen voor staging/QA, laat leeg in productie.
#
# Backwards compat: META_PIXEL_ID wordt gelezen als fallback voor META_DATASET_ID.
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# OpenAI (AI Meta Campaign Studio: copy + image generation)
OPENAI_API_KEY=

# Teamleader Focus
# STANDAARD: klanten brengen hun eigen OAuth-app mee. Warme Leads hoeft niets te zetten.
# Onderstaande env vars zijn alleen nodig als je optioneel een centrale Warme Leads-app
# aanbiedt (fallback voor klanten die geen eigen integratie willen maken).
# Geen newlines in waarden. Zie docs/TEAMLEADER_INTEGRATION.md
# TEAMLEADER_CLIENT_ID=
# TEAMLEADER_CLIENT_SECRET=
# TEAMLEADER_REDIRECT_URI=https://warmeleads.eu/api/portal/integrations/teamleader/callback
# Versleuteling van per-klant tokens (anders fallback op APP_SESSION_SECRET/CRON_SECRET).
# INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Environment
NODE_ENV=development
