# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Sessie-JWT (admin + portal + impersonatie). Min. 32 tekens. Zet dit in Vercel
# productie (niet alleen CRON_SECRET gebruiken).
APP_SESSION_SECRET=

# Admin-auth debug: server (Vercel function logs) + client (ingelogde adminFetch).
# Optioneel: alleen serverlogs zonder client-buildflag.
NEXT_PUBLIC_ADMIN_AUTH_DEBUG=
ADMIN_AUTH_DEBUG=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database Configuration (legacy - niet meer nodig met Supabase)
DATABASE_URL=postgresql://username:password@localhost:5432/warmeleads
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Email Configuration (for future use)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@warmeleads.nl

# CRM Integration (for future use)
HUBSPOT_API_KEY=your_hubspot_api_key
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret

# Lead Generation API (for future use)
LEAD_GENERATION_API_URL=https://api.leadprovider.com
LEAD_GENERATION_API_KEY=your_lead_api_key

# Analytics (for future use)
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
FACEBOOK_PIXEL_ID=your_facebook_pixel_id

# Twilio WhatsApp Business API (QuickPulse Style)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel KV for WhatsApp config storage
KV_URL=your_vercel_kv_url
KV_REST_API_TOKEN=your_vercel_kv_token

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Resend API for email notifications
RESEND_API_KEY=re_your_resend_api_key

# Meta/Facebook Ads Configuration
# Campaign status sync (batch ↔ Meta): token needs ads_management + campagnes in dit ad account.
META_APP_ID=827176273582025
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_app_id|your_app_secret
META_AD_ACCOUNT_ID=act_xxxxxxxx
META_WEBHOOK_VERIFY_TOKEN=warmeleads_verify_token

# Meta Conversions API for Lead Ads (server-side Lead/QualifiedLead/Purchase events).
#
# Wij draaien Lead Ads (Meta Lead Forms), niet pixelevents op een website.
# In Events Manager heet de identifier "Dataset ID" — een Pixel is ook een dataset.
# Eén dataset is voldoende voor alle branches: per event sturen we het Lead Ads
# submission-id (`lead_id`) + branch/campaign/adset/ad-id mee zodat Meta de events
# correct toewijst aan de juiste campagne.
#
# Maak één dataset aan via:
#   Events Manager → Datasets → Connect new data source → CRM
# (of hergebruik een bestaande Pixel; technisch is dat ook gewoon een dataset).
#
# Access token: maak een System User in Business Manager met "Manage business"
# en "Manage dataset" permissies, of hergebruik META_ACCESS_TOKEN als die rechten
# heeft. Test events kun je in Events Manager → Test Events activeren met een code.
#
# Backwards compat: META_PIXEL_ID wordt nog gelezen als fallback.
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# OpenAI (AI Meta Campaign Studio: copy + image generation)
OPENAI_API_KEY=

# Environment
NODE_ENV=development
