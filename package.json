{
  "name": "warmeleads-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "dev:stable": "./start-stable.sh",
    "dev:original": "./start-server.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "fix:lead-addresses": "npx tsx scripts/fix-lead-addresses-from-postcode.ts",
    "fix:reassign-bulk-export": "npx tsx scripts/reassign-bulk-export-leads.ts",
    "preview": "npm run build && npm run start",
    "clean": "rm -rf .next node_modules/.cache",
    "restart": "npm run clean && npm run dev",
    "generate-blog": "node scripts/auto-blog-generator.js",
    "weekly-content": "npm run generate-blog && npm run build && npx vercel --prod --yes"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.1",
    "@mollie/api-client": "^4.5.0",
    "@react-pdf/renderer": "^4.3.1",
    "@sentry/browser": "^8.55.2",
    "@supabase/supabase-js": "^2.78.0",
    "@tanstack/react-query": "^5.90.6",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/handlebars": "^4.0.40",
    "@types/uuid": "^10.0.0",
    "@vercel/blob": "^2.0.0",
    "@vercel/kv": "^3.0.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "handlebars": "^4.7.8",
    "jose": "^6.2.2",
    "jszip": "^3.10.1",
    "next": "^14.2.15",
    "nodemailer": "^9.0.3",
    "openai": "^6.38.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
    "resend": "^6.1.2",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/ui": "^4.0.6",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^4.0.6"
  }
